---
import { getSecurityReview, summarizeSecurityReview } from '../data/security-reviews.js';

interface Props {
  skill: {
    id: string;
    name: string;
    source: Record<string, string>;
    files: { path: string; content: string }[];
  };
}

const { skill } = Astro.props;
const reports = import.meta.glob('../data/security-reviews/*.json', { eager: true, import: 'default' });
const review = getSecurityReview(reports[`../data/security-reviews/${skill.id}.json`], skill);
const report = review.report;
const summary = summarizeSecurityReview(review);
const headingId = `security-review-${skill.id}`;
const categoryLabels: Record<string, string> = {
  'prompt-injection': 'Prompt injection',
  'credential-exposure': 'Credential exposure',
  'data-exfiltration': 'Data exfiltration',
  'destructive-operation': 'Destructive operation',
  'unsafe-execution': 'Unsafe execution',
  'supply-chain': 'Supply chain',
  other: 'Other concern',
};
const actions: Record<string, string> = {
  'prompt-injection': 'Check for instructions that override your request or permissions. Remove or reject unauthorized instructions.',
  'credential-exposure': 'Check which credentials are read or shared. Do not provide secrets to untrusted instructions.',
  'data-exfiltration': 'Verify the destination and data being sent. Do not authorize unexpected transfers.',
  'destructive-operation': 'Check the target and scope of changes. Back up data and require confirmation before destructive actions.',
  'unsafe-execution': 'Inspect the command or code before running it. Avoid executing untrusted downloads.',
  'supply-chain': 'Verify the package or download source and version before installing.',
  other: 'Check the cited instructions against your intended task and permissions before proceeding.',
};
const severityOrder = { critical: 0, high: 1, medium: 2, low: 3 };
const findings = [...(report?.findings ?? [])].sort((a, b) => severityOrder[a.severity] - severityOrder[b.severity]);
---

<section class="security-review" aria-labelledby={headingId} data-review-status={review.status}>
  <header class="review-header">
    <h2 id={headingId}>Security review</h2>
    <span class="review-status">{summary.label}</span>
  </header>
  <p class="review-message">{review.message}</p>
  <p class="review-overview">
    <span>{summary.coverage}</span>
    {report && (
      <span> · <time datetime={report.reviewedAt}>{new Date(report.reviewedAt).toLocaleDateString('en-US', { dateStyle: 'medium', timeZone: 'UTC' })}</time> (UTC)</span>
    )}
    {summary.gaps > 0 && <span> · {summary.gaps} not reviewed</span>}
  </p>

  {findings.length > 0 && (
    <div class="review-findings">
      <h3>{review.status === 'stale' ? 'Previous review: ' : ''}{findings.length} finding{findings.length === 1 ? '' : 's'} to assess</h3>
      <p class="finding-guidance">These are AI-reported concerns, not confirmed vulnerabilities.</p>
      <ol class="findings-list">
        {findings.map(finding => (
          <li class="review-finding">
            <h4><span class={`finding-severity severity-${finding.severity}`}>{finding.severity}</span> {categoryLabels[finding.category]}</h4>
            <p class="finding-location"><code>{finding.path}</code> · lines {finding.startLine}–{finding.endLine}</p>
            <p class="finding-explanation">{finding.explanation}</p>
            <p class="finding-action"><strong>Before installing:</strong> {actions[finding.category]}</p>
            <details class="finding-details">
              <summary>View cited evidence</summary>
              <pre class="finding-evidence"><code>{finding.quote}</code></pre>
            </details>
          </li>
        ))}
      </ol>
    </div>
  )}

  <details class="review-details">
    <summary>Review details{summary.gaps > 0 ? ' and coverage gaps' : ''}</summary>
    <p>AI instruction review via <a href="https://github.com/samueltauil/skills-hub/blob/main/.github/workflows/skill-security-review.md">GitHub Agentic Workflows</a>.
      Reviews inspect a recorded catalog snapshot; they do not execute skill files. AI can miss risks or report false positives.</p>
    <p>Coverage is limited to catalog files. External links and upstream files absent from the catalog were not inspected.</p>
    {report && (
      <>
        <dl class="review-meta">
          <div><dt>Model</dt><dd>{report.model}</dd></div>
          <div><dt>Rubric</dt><dd>{report.rubricVersion}</dd></div>
          <div><dt>Catalog commit</dt><dd><code>{report.revision}</code></dd></div>
          <div><dt>Content hash</dt><dd><code>{report.contentHash}</code></dd></div>
        </dl>
        {report.coverage.omittedFiles.length > 0 && (
          <><h3>Omitted files</h3><ul>{report.coverage.omittedFiles.map(file => <li><code>{file.path}</code>: {file.reason.replaceAll('-', ' ')}</li>)}</ul></>
        )}
        {report.coverage.unreviewedFiles.length > 0 && (
          <><h3>Not reviewed</h3><ul>{report.coverage.unreviewedFiles.map(file => <li><code>{file}</code></li>)}</ul></>
        )}
        {report.coverage.reviewedFiles.length > 0 && (
          <details class="reviewed-files">
            <summary>Reviewed files ({report.coverage.reviewedFiles.length})</summary>
            <ul>{report.coverage.reviewedFiles.map(file => <li><code>{file}</code></li>)}</ul>
          </details>
        )}
        {report.errors.length > 0 && (
          <><h3>Review errors</h3><ul>{report.errors.map(error => <li>{error}</li>)}</ul></>
        )}
        <a class="report-link" href={`https://github.com/samueltauil/skills-hub/blob/main/site/src/data/security-reviews/${skill.id}.json`}>View full report (JSON)</a>
      </>
    )}
  </details>
</section>

<style>
  .security-review { min-width: 0; padding: clamp(1rem, 3vw, 1.5rem); margin-bottom: 2rem; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg-secondary); overflow-wrap: anywhere; }
  .review-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; }
  h2 { font-size: 1.25rem; }
  h3 { font-size: 1rem; margin: 1rem 0 0.5rem; }
  h4 { font-size: 0.875rem; line-height: 1.6; }
  .review-status { padding: 0.25rem 0.625rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg-tertiary); font-size: 0.8125rem; font-weight: 600; }
  [data-review-status="complete-with-findings"] .review-status,
  [data-review-status="stale"] .review-status,
  [data-review-status="incomplete"] .review-status,
  [data-review-status="error"] .review-status { color: var(--color-warning); }
  p, li, dd { font-size: 0.875rem; line-height: 1.6; }
  p { margin-top: 0.75rem; }
  .review-message { color: var(--color-text); }
  .review-overview, .finding-guidance, .finding-location, .review-details { color: var(--color-text-secondary); }
  .review-overview, .finding-location { font-size: 0.8125rem; }
  .findings-list { list-style: none; padding: 0; }
  .review-finding { min-width: 0; margin-top: 0.75rem; padding: 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .finding-severity { display: inline-block; margin-right: 0.375rem; font-size: 0.75rem; text-transform: uppercase; }
  .severity-critical, .severity-high { color: var(--color-danger); }
  .severity-medium { color: var(--color-warning); }
  .finding-location, .finding-explanation, .finding-evidence, dd, li { unicode-bidi: plaintext; }
  .finding-evidence { max-width: 100%; padding: 0.75rem; margin-top: 0.5rem; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 0.8125rem; }
  .finding-evidence code { white-space: inherit; }
  .finding-details, .review-details, .reviewed-files { margin-top: 1rem; }
  .review-details { border-top: 1px solid var(--color-border); padding-top: 0.75rem; }
  summary { cursor: pointer; padding: 0.375rem 0; color: var(--color-accent); font-size: 0.875rem; }
  summary:focus-visible, a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .review-meta { margin-top: 1rem; }
  .review-meta div { display: grid; grid-template-columns: minmax(0, 8rem) minmax(0, 1fr); gap: 0.5rem; margin-top: 0.5rem; }
  dt { font-size: 0.8125rem; }
  dd { min-width: 0; }
  code { overflow-wrap: anywhere; }
  ul { padding-left: 1.25rem; margin-top: 0.5rem; }
  .report-link { display: inline-block; margin-top: 1rem; }
  @media (max-width: 480px) { .review-meta div { grid-template-columns: minmax(0, 1fr); gap: 0.125rem; } }
</style>
