---
import { getCategory } from '../data/categories';
import CategoryLogo from './CategoryLogo.astro';

interface Props {
  id: string;
  name: string;
  description: string;
  category: string;
  triggers?: string[];
  author?: string;
  fileCount?: number;
  verified?: boolean;
  securityScan?: {
    scannedAt: string;
    verified: boolean;
    issueCount: number;
    highCount: number;
  };
  source?: {
    repoName: string;
  };
}

const { id, name, description, category, triggers = [], fileCount = 0, verified = false, securityScan, source } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const categoryInfo = getCategory(category);

// Convert kebab-case to Title Case
function formatName(str: string): string {
  return str
    .split('-')
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

const displayName = formatName(name);
---

<article class="skill-card card">
  <div class="skill-top">
    <span class="skill-category" title={categoryInfo.name}>
      <CategoryLogo id={category} size={24} />
      <span class="skill-category-name">{categoryInfo.name}</span>
    </span>
    <div class="skill-badges">
      {verified && (
        <span class="badge-verified" title="Security scan passed – no dangerous patterns detected">
          <svg class="verified-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 1.5L2 4v4c0 3.3 2.5 5.8 6 6.5 3.5-.7 6-3.2 6-6.5V4L8 1.5z" fill="rgba(63,185,80,0.2)" stroke="#3fb950" stroke-width="1.2" stroke-linejoin="round"/>
            <path d="M5.5 8l1.8 1.8L10.5 6.5" stroke="#3fb950" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Verified
        </span>
      )}
      {!verified && securityScan && (
        <span class="badge-scanned" title={`Security scan found ${securityScan.issueCount} issue(s)`}>
          <svg class="scanned-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 1.5L2 4v4c0 3.3 2.5 5.8 6 6.5 3.5-.7 6-3.2 6-6.5V4L8 1.5z" fill="rgba(210,153,34,0.15)" stroke="#d29922" stroke-width="1.2" stroke-linejoin="round"/>
            <path d="M8 5v3.5M8 10.5v.5" stroke="#d29922" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
          Scanned
        </span>
      )}
    </div>
  </div>

  <h3 class="skill-name">
    <a href={`${baseUrl}skills/${id}/`} class="skill-link">{displayName}</a>
  </h3>

  <p class="skill-description">{description}</p>

  {triggers.length > 0 && (
    <div class="skill-triggers">
      <span class="triggers-label">Triggers:</span>
      <div class="triggers-list">
        {triggers.slice(0, 3).map(trigger => (
          <code class="trigger">{trigger}</code>
        ))}
        {triggers.length > 3 && <span class="more">+{triggers.length - 3}</span>}
      </div>
    </div>
  )}

  <div class="skill-meta">
    {source?.repoName && (
      <span class="meta-info source-info" title={source.repoName}>
        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        <span class="source-name">{source.repoName}</span>
      </span>
    )}
    {fileCount > 0 && (
      <span class="meta-info">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
        </svg>
        {fileCount} {fileCount === 1 ? 'file' : 'files'}
      </span>
    )}
  </div>
  
</article>

<style>
  .skill-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    min-width: 0;
    transition: border-color 0.2s ease, 
                box-shadow 0.2s ease, 
                transform 0.2s ease;
  }

  .skill-card:hover {
    transform: translateY(-3px);
  }

  .skill-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 1.5rem;
  }

  .skill-category {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .skill-category-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .skill-badges {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex-shrink: 0;
  }

  .badge-verified {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.55rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    border-radius: 9999px;
    background: linear-gradient(135deg, rgba(63, 185, 80, 0.12) 0%, rgba(63, 185, 80, 0.06) 100%);
    color: #3fb950;
    border: 1px solid rgba(63, 185, 80, 0.35);
    white-space: nowrap;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .badge-verified:hover {
    box-shadow: 0 0 8px rgba(63, 185, 80, 0.25);
    border-color: rgba(63, 185, 80, 0.6);
  }

  .verified-icon {
    width: 11px;
    height: 11px;
    flex-shrink: 0;
  }

  .badge-scanned {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.55rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    border-radius: 9999px;
    background: linear-gradient(135deg, rgba(210, 153, 34, 0.12) 0%, rgba(210, 153, 34, 0.06) 100%);
    color: #d29922;
    border: 1px solid rgba(210, 153, 34, 0.35);
    white-space: nowrap;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .badge-scanned:hover {
    box-shadow: 0 0 8px rgba(210, 153, 34, 0.25);
    border-color: rgba(210, 153, 34, 0.6);
  }

  .scanned-icon {
    width: 11px;
    height: 11px;
    flex-shrink: 0;
  }

  .skill-name {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .skill-name a {
    color: var(--color-text);
    transition: color 0.15s ease;
  }

  /* Make the whole card clickable while keeping a single, accessible link */
  .skill-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .skill-card:hover .skill-name a,
  .skill-name a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .skill-name a:focus-visible {
    outline: none;
  }

  .skill-description {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
    min-height: calc(0.875rem * 1.5 * 3);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .skill-meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .meta-info {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .source-info {
    flex-shrink: 1;
    min-width: 0;
    max-width: 75%;
    overflow: hidden;
    padding: 0.125rem 0.5rem;
    background: var(--color-bg-tertiary);
    border-radius: var(--radius-sm);
  }

  .source-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .skill-author {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .skill-triggers {
    border-top: 1px solid var(--color-border);
    padding-top: 0.75rem;
    margin-top: 0.25rem;
  }

  .triggers-label {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    display: block;
    margin-bottom: 0.5rem;
  }

  .triggers-list {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .trigger {
    font-size: 0.75rem;
    padding: 0.125rem 0.375rem;
  }

  .more {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }
</style>
