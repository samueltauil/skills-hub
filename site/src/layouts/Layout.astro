---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { createMetadata, serializeJsonLd, SITE_NAME } from '../data/seo.js';

interface Props {
  title: string;
  description?: string;
  pageType?: 'WebPage' | 'CollectionPage';
  breadcrumbs?: { name: string; path: string }[];
  skill?: { name: string; description: string; sourceUrl?: string };
}

const { title, description, pageType, breadcrumbs, skill } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const section = path.startsWith(`${baseUrl}skills`) ? 'skills' : path.startsWith(`${baseUrl}categories`) ? 'categories' : path === baseUrl ? 'home' : '';
const metadata = createMetadata({
  site: Astro.site, pageUrl: Astro.url, baseUrl, title, description, pageType, breadcrumbs, skill,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metadata.description} />
    <link rel="canonical" href={metadata.canonical} />
    <link rel="describedby" href={new URL(`${baseUrl}llms.txt`, Astro.site).href} type="text/plain" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} />
    <meta property="og:url" content={metadata.canonical} />
    <meta property="og:image" content={metadata.image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Copilot Skills Hub — discover and install Agent Skills for GitHub Copilot" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} />
    <meta name="twitter:image" content={metadata.image} />
    <meta name="twitter:image:alt" content="Copilot Skills Hub — discover and install Agent Skills for GitHub Copilot" />
    <script type="application/ld+json" set:html={serializeJsonLd(metadata.jsonLd)} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <title>{metadata.title}</title>
    <Analytics />
  </head>
  <body>
    <header class="header">
      <nav class="container nav">
        <a href={`${baseUrl}`} class="logo">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Skills Hub</span>
        </a>
        <div class="nav-links">
          <a href={`${baseUrl}`} class="nav-home" aria-current={section === 'home' ? 'page' : undefined}>Home</a>
          <a href={`${baseUrl}skills/`} aria-current={section === 'skills' ? 'page' : undefined}><span class="nav-long">Browse </span>Skills</a>
          <a href={`${baseUrl}categories/`} aria-current={section === 'categories' ? 'page' : undefined}>Categories</a>
          <a href="https://github.com/samueltauil/skills-hub" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" aria-label="Skills Hub on GitHub">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </svg>
            <span class="nav-label">GitHub</span>
          </a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <p class="text-secondary">
          Copilot Skills Hub — Discover and install curated GitHub Copilot skills.
        </p>
        <p class="text-secondary">
          <a href="https://github.com/samueltauil/skills-hub" target="_blank" rel="noopener noreferrer">View on GitHub</a>
          ·
          <a href="https://github.com/samueltauil/skills-hub/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer">Contribute a Skill</a>
        </p>
        <p class="footer-made-with">Built with <a href="https://github.com/features/copilot" target="_blank" rel="noopener noreferrer">GitHub Copilot</a></p>
      </div>
    </footer>
  </body>
</html>

<style>
  .header {
    background-color: rgba(22, 27, 34, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
    transition: background-color var(--transition-normal, 0.2s ease),
                box-shadow var(--transition-normal, 0.2s ease);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    transition: color var(--transition-normal, 0.2s ease),
                transform var(--transition-fast, 0.15s ease);
  }

  .logo:hover {
    color: var(--color-accent);
    text-decoration: none;
    transform: translateX(2px);
  }

  .logo svg {
    transition: transform var(--transition-normal, 0.2s ease);
  }

  .logo:hover svg {
    transform: rotate(-10deg) scale(1.05);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-links a {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    transition: color var(--transition-fast, 0.15s ease);
    position: relative;
  }

  .nav-links a:not(.btn)::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-accent);
    transition: width var(--transition-normal, 0.2s ease);
  }

  .nav-links a:not(.btn):hover::after {
    width: 100%;
  }

  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-links a[aria-current='page']::after {
    width: 100%;
  }

  .footer {
    border-top: 1px solid var(--color-border);
    padding: 2rem 0;
    margin-top: 4rem;
    text-align: center;
  }

  .footer p {
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
  }

  .footer a {
    transition: color var(--transition-fast, 0.15s ease);
  }

  .footer-made-with {
    font-size: 0.8125rem !important;
    color: var(--color-text-secondary);
    margin-top: 0.75rem !important;
    opacity: 0.8;
  }

  .footer-made-with a {
    color: var(--color-accent);
    font-weight: 500;
  }

  .footer-made-with a:hover {
    color: var(--color-accent-hover, #79b8ff);
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .nav {
      padding: 0.75rem 1rem;
    }

    .logo {
      font-size: 1.125rem;
    }

    .nav-links {
      gap: 1rem;
    }

    .nav-home,
    .nav-long,
    .nav-label {
      display: none;
    }
  }
</style>
