---
import Layout from '../layouts/Layout.astro';
import SkillCard from '../components/SkillCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import SearchBar from '../components/SearchBar.astro';

// Import aggregated skills data
import skillsData from '../data/skills.json';
import { categoryMeta } from '../data/categories';
import { MARKETPLACE_NAME, MARKETPLACE_REPO } from '../data/plugins';

const featuredSkills = skillsData.skills.slice(0, 6);

// Build categories with counts from skills
const categoryCounts = skillsData.skills.reduce((acc, skill) => {
  const cat = skill.category || 'general';
  acc[cat] = (acc[cat] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const categories = Object.entries(categoryCounts).map(([id, count]) => ({
  id,
  name: categoryMeta[id]?.name || id,
  description: categoryMeta[id]?.description || '',
  count
})).sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const vscodeAddMarketplace = `https://vscode.dev/redirect?url=${encodeURIComponent(`vscode://chat-plugin/add-marketplace?ref=${encodeURIComponent(MARKETPLACE_REPO)}`)}`;
const marketplaceCommand = `copilot plugin marketplace add ${MARKETPLACE_REPO}`;
const skillInstallCommand = `copilot plugin install <skill-id>@${MARKETPLACE_NAME}`;
const pluginInstallCommands = `${marketplaceCommand}\n${skillInstallCommand}`;

const sourceCount = new Set(skillsData.skills.map(s => s.source?.repoName).filter(Boolean)).size;
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-glow hero-glow-1"></div>
      <div class="hero-glow hero-glow-2"></div>
    </div>
    <div class="container hero-content">
      <h1 class="hero-title">
        <span class="title-line">Skills <span class="title-accent">Hub</span></span>
      </h1>
      <p class="hero-subtitle">
        Explore {skillsData.skills.length} curated Agent Skills, packaged individually as Agent Plugins for GitHub Copilot.
      </p>
      <div class="hero-search">
        <SearchBar placeholder="Search for skills..." id="hero-search" />
      </div>
      <div class="hero-stats">
        <div class="stat-card">
          <span class="stat-value">{skillsData.skills.length}</span>
          <span class="stat-label">Skills</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-card">
          <span class="stat-value">{categories.length}</span>
          <span class="stat-label">Categories</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-card">
          <span class="stat-value">{sourceCount}</span>
          <span class="stat-label">Sources</span>
        </div>
      </div>

      <div class="hero-cli">
        <p class="cli-label">Install a skill with GitHub Copilot CLI</p>
        <div class="cli-command">
          <pre><code>{pluginInstallCommands}</code></pre>
          <button class="cli-copy-btn" id="cli-copy-btn" title="Copy install commands" aria-label="Copy plugin install commands">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
          </button>
        </div>
        <p class="cli-hint">Replace <code>&lt;skill-id&gt;</code> with the ID on any skill page.</p>
        <a class="cli-vscode-link" href={vscodeAddMarketplace}>Set up the marketplace in VS Code</a>
      </div>
    </div>
  </section>

  <!-- Featured Skills -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Featured Skills</h2>
        <a href={`${import.meta.env.BASE_URL}skills/`} class="btn btn-secondary btn-sm">View All →</a>
      </div>
      <div class="grid grid-3">
        {featuredSkills.map(skill => (
          <SkillCard 
            id={skill.id}
            name={skill.name}
            description={skill.description}
            category={skill.category}
            fileCount={skill.files?.length || 0}
            source={skill.source}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Browse by Category</h2>
        <a href={`${import.meta.env.BASE_URL}categories/`} class="btn btn-secondary btn-sm">All Categories →</a>
      </div>
      <div class="grid grid-3">
        {categories.slice(0, 9).map(category => (
          <CategoryCard 
            id={category.id}
            name={category.name}
            description={category.description}
            count={category.count}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- How to Install -->
  <section class="section install-section" aria-labelledby="install-heading">
    <div class="container">
      <h2 class="section-title text-center" id="install-heading">How to Install</h2>
      <p class="section-subtitle text-center">Each skill is an <a href="https://agent-plugins.org" target="_blank" rel="noopener noreferrer">Agent Plugin</a>. Install from your terminal or directly in your editor.</p>

      <div class="install-steps">
        <div class="step cli-install">
          <div class="install-method"><span>Terminal</span><span class="step-tag">Recommended</span></div>
          <h3>GitHub Copilot CLI</h3>
          <p class="step-desc">Add the marketplace once, then choose a skill to install.</p>
          <ol class="install-checklist">
            <li>
              <h4>Add the Skills Hub marketplace</h4>
              <div class="install-command">
                <pre><code>{marketplaceCommand}</code></pre>
                <button type="button" class="install-copy" data-command={marketplaceCommand} aria-label="Copy marketplace command" hidden>Copy</button>
              </div>
            </li>
            <li>
              <h4>Install your chosen skill</h4>
              <div class="install-command">
                <pre><code>{skillInstallCommand}</code></pre>
                <button type="button" class="install-copy" data-command={skillInstallCommand} aria-label="Copy skill install command" hidden>Copy</button>
              </div>
              <p class="step-desc command-hint">Replace <code>&lt;skill-id&gt;</code> with the ID on any <a href={`${import.meta.env.BASE_URL}skills/`}>skill page</a>, where you can also copy its exact command.</p>
            </li>
          </ol>
          <p id="install-copy-status" class="copy-status" role="status" aria-live="polite"></p>
        </div>
        <div class="step editor-install">
          <div class="install-method"><span>Editor</span><span class="editor-tag">Stay in VS Code</span></div>
          <h3>Visual Studio Code</h3>
          <p class="step-desc">Browse and install skills without leaving your editor.</p>
          <ol class="editor-checklist">
            <li>Enable <code>chat.plugins.enabled</code> in settings.</li>
            <li>Add the Skills Hub marketplace using the button below.</li>
            <li>Open <strong>Agent Customizations</strong> to browse and install a plugin.</li>
          </ol>
          <a href={vscodeAddMarketplace} class="btn btn-secondary">Add marketplace to VS Code <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <p class="install-note"><strong>One catalog, two ways to install.</strong> Both options use the same Skills Hub marketplace.</p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    text-align: center;
    padding: 5rem 0 4rem;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--color-bg-secondary) 0%, var(--color-bg) 100%);
    z-index: 0;
  }

  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.4;
    animation: pulse 8s ease-in-out infinite;
  }

  .hero-glow-1 {
    width: 400px;
    height: 400px;
    background: var(--color-accent);
    top: -150px;
    left: 20%;
    animation-delay: 0s;
  }

  .hero-glow-2 {
    width: 300px;
    height: 300px;
    background: #a855f7;
    bottom: -100px;
    right: 20%;
    animation-delay: 4s;
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0.3;
    }
    50% {
      transform: scale(1.1);
      opacity: 0.5;
    }
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-title {
    font-size: 4rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
    animation: fadeInUp 0.6s ease-out 0.1s both;
  }

  .title-line {
    color: var(--color-text);
  }

  .title-accent {
    background: linear-gradient(135deg, var(--color-accent) 0%, #a855f7 50%, var(--color-accent) 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmer 3s linear infinite;
  }

  @keyframes shimmer {
    0% {
      background-position: 0% center;
    }
    100% {
      background-position: 200% center;
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
    animation: fadeInUp 0.6s ease-out 0.2s both;
  }

  .hero-search {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
    animation: fadeInUp 0.6s ease-out 0.3s both;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    animation: fadeInUp 0.6s ease-out 0.4s both;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .stat-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stat-divider {
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(180deg, transparent, var(--color-border), transparent);
  }

  .hero-cli {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    animation: fadeInUp 0.6s ease-out 0.5s both;
  }

  .cli-label {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cli-command {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 34rem;
    padding: 0.625rem 1rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-accent);
    transition: border-color var(--transition-fast, 0.15s ease);
  }

  .cli-command pre {
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    text-align: left;
    overflow-x: auto;
  }

  .cli-command code {
    padding: 0;
    background: transparent;
    color: inherit;
    font-size: 0.75rem;
    white-space: pre;
  }

  .cli-command:hover {
    border-color: var(--color-accent);
  }

  .cli-copy-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    background: transparent;
    border: none;
    color: var(--color-text-secondary);
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast, 0.15s ease);
  }

  .cli-copy-btn:hover {
    color: var(--color-accent);
    background: var(--color-bg-tertiary);
  }

  .cli-vscode-link {
    font-size: 0.8125rem;
  }

  .cli-hint {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .cli-copy-btn.copied {
    color: var(--color-success);
  }

  .section {
    padding: 3rem 0;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .install-section {
    background-color: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-top: 2rem;
  }

  .install-steps {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 1.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .step {
    min-width: 0;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .install-method {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between;
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .cli-install { border-top: 2px solid var(--color-accent); }
  .editor-tag { font-size: 0.6875rem; font-weight: 400; }

  .step h3 {
    font-size: 1.25rem;
    line-height: 1.4;
    margin-bottom: 0.75rem;
  }

  .step-tag {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.125rem 0.5rem;
    background: rgba(88, 166, 255, 0.15);
    color: var(--color-accent);
    border-radius: var(--radius-full, 999px);
    vertical-align: middle;
  }

  .step-desc {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }

  .step pre {
    min-width: 0;
    max-width: 100%;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.8125rem;
    margin: 0;
    overflow-x: auto;
  }

  .step code { overflow-wrap: anywhere; }
  .install-checklist { list-style: none; counter-reset: install; margin-top: 1.5rem; }
  .install-checklist > li { counter-increment: install; margin-top: 1.25rem; }
  .install-checklist h4 { display: flex; align-items: center; gap: 0.625rem; font-size: 0.8125rem; font-weight: 500; margin-bottom: 0.75rem; }
  .install-checklist h4::before { content: counter(install); display: grid; place-items: center; width: 1.5rem; height: 1.5rem; flex-shrink: 0; color: var(--color-accent); background: rgba(88, 166, 255, 0.12); border-radius: 50%; font-size: 0.75rem; }
  .install-command { display: flex; align-items: flex-start; gap: 0.5rem; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg-secondary); }
  .install-command pre { flex: 1; padding: 0; border: 0; background: transparent; align-self: center; }
  .install-copy { flex-shrink: 0; padding: 0.375rem 0.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg-tertiary); color: var(--color-text); font: inherit; font-size: 0.6875rem; cursor: pointer; }
  .install-copy[hidden] { display: none; }
  .install-copy:hover { border-color: var(--color-accent); }
  .step a:focus-visible, .install-copy:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .command-hint { margin: 0.625rem 0 0; font-size: 0.75rem; }
  .copy-status { font-size: 0.75rem; color: var(--color-text-secondary); }
  .copy-status:not(:empty) { margin-top: 0.75rem; }
  .editor-checklist { padding-left: 1.25rem; color: var(--color-text-secondary); font-size: 0.875rem; margin: 1.5rem 0; }
  .editor-checklist li { padding-left: 0.25rem; margin-bottom: 0.75rem; }
  .editor-checklist strong { color: var(--color-text); font-weight: 500; }
  .install-note { text-align: center; max-width: 700px; margin: 1.5rem auto 0; color: var(--color-text-secondary); font-size: 0.8125rem; overflow-wrap: anywhere; }
  .install-note strong { color: var(--color-text); }

  @media (max-width: 768px) {
    .hero {
      padding: 3rem 0 2.5rem;
    }

    .hero-title {
      font-size: 2.5rem;
    }

    .hero-subtitle {
      font-size: 1rem;
    }

    .hero-stats {
      gap: 1rem;
    }

    .stat-value {
      font-size: 1.25rem;
    }

    .stat-divider {
      height: 2rem;
    }

    .install-steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-glow {
      animation: none;
    }

    .hero-title,
    .hero-subtitle,
    .hero-search,
    .hero-stats,
    .hero-cli {
      animation: none;
    }

    .title-accent {
      animation: none;
    }
  }
</style>

<script define:vars={{ baseUrl: import.meta.env.BASE_URL, pluginInstallCommands }}>
  const heroSearch = document.getElementById('hero-search');
  heroSearch?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const query = heroSearch.value.trim();
      if (query) {
        window.location.href = `${baseUrl}skills/?q=${encodeURIComponent(query)}`;
      } else {
        window.location.href = `${baseUrl}skills/`;
      }
    }
  });

  // CLI copy button
  const cliCopyBtn = document.getElementById('cli-copy-btn');
  cliCopyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText(pluginInstallCommands).then(() => {
      cliCopyBtn.classList.add('copied');
      setTimeout(() => cliCopyBtn.classList.remove('copied'), 2000);
    });
  });

  const installCopyStatus = document.getElementById('install-copy-status');
  document.querySelectorAll('.install-copy').forEach(button => {
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.command);
        installCopyStatus.textContent = 'Command copied to clipboard.';
      } catch {
        installCopyStatus.textContent = 'Could not copy. Select the command text and copy it manually.';
      }
    });
  });
</script>
